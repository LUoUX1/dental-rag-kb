# 口腔医学知识库环境配置
# DeepSeek API Key（从 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
KB_PORT=YOUR_KB_PORT_HERE

# Discord 机器人配置
DENTAL_BOT_TOKEN=YOUR_DENTAL_BOT_TOKEN_HERE
# 代理（中国大陆访问 Discord 必需）
HTTP_PROXY=YOUR_HTTP_PROXY_HERE
HTTPS_PROXY=YOUR_HTTPS_PROXY_HERE
# 可选：限定频道 ID（逗号分隔，留空=所有频道）
# DENTAL_BOT_CHANNELS=123456789,987654321
